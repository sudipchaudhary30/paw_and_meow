{
	"info": {
		"_postman_id": "c1f7a29e-4e8b-4a55-934d-88f4e190342a",
		"name": "Paw & Meow - Email Verification Proof",
		"description": "Collection to test Email Verification code generation and confirmation in Postman.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Get CSRF Token",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData.csrfToken) {",
							"    pm.environment.set('csrf_token', jsonData.csrfToken);",
							"    console.log('CSRF Token saved:', jsonData.csrfToken);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:5000/api/csrf-token",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "5000",
					"path": [
						"api",
						"csrf-token"
					]
				}
			},
			"response": []
		},
		{
			"name": "2. Request Email Verification Code",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData.verificationCode) {",
							"    pm.environment.set('email_code', jsonData.verificationCode);",
							"    console.log('Verification Code saved:', jsonData.verificationCode);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "x-csrf-token",
						"value": "{{csrf_token}}",
						"type": "text"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "http://localhost:5000/api/auth/email/verify/request",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "5000",
					"path": [
						"api",
						"auth",
						"email",
						"verify",
						"request"
					]
				}
			},
			"response": []
		},
		{
			"name": "3. Confirm Email Verification Code",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "x-csrf-token",
						"value": "{{csrf_token}}",
						"type": "text"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"code\": \"{{email_code}}\"\n}"
				},
				"url": {
					"raw": "http://localhost:5000/api/auth/email/verify/confirm",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "5000",
					"path": [
						"api",
						"auth",
						"email",
						"verify",
						"confirm"
					]
				}
			},
			"response": []
		}
	]
}
